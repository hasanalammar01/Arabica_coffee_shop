# Menu admin (/admin). See README "Go live".
# Staff password. Leave empty during `npm run dev` to open the admin without a login.
ADMIN_PASSWORD=
# GitHub fine-grained token: only this repository, Contents read/write.
# Leave empty during `npm run dev` to save to local files instead.
GITHUB_TOKEN=

# Optional: turn on Plausible analytics
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
