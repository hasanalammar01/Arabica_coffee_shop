# Menu admin (/admin). See README "Go live".
# Admin password (username "admin") until it's changed in the admin's Settings.
# Leave empty during `npm run dev` to open the admin without a login.
ADMIN_PASSWORD=
# Menu, shop information, orders and staff accounts. Added by Vercel → Storage → Neon.
# Without DATABASE_URL, development saves the menu and shop info to local JSON files.
# Locally, paste the connection string from Neon here (in .env.local, never committed).
DATABASE_URL=
# Menu photos: connect a public Vercel Blob store to this project.
# On Vercel the Blob SDK uses BLOB_STORE_ID and the deployment's OIDC credentials.
BLOB_STORE_ID=
# Optional for local development outside Vercel: the Blob store's read-write token.
# Keep this server-side; never use a NEXT_PUBLIC_ prefix for credentials.
BLOB_READ_WRITE_TOKEN=
# Optional: email notifications for new orders, from resend.com.
RESEND_API_KEY=
# Optional: the sender, once a domain is verified in Resend (default: onboarding@resend.dev).
EMAIL_FROM=

# Optional: turn on Plausible analytics
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
